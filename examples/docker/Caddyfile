:80 {
    # /_henge is for your own processes. Never route it from the edge.
    respond /_henge/* 404

    reverse_proxy {
        # Every replica behind the "shop" name, not whichever one DNS answered first.
        dynamic a shop 8080

        # Caddy runs no active health checks (health_uri) against dynamic upstreams, so a replica that
        # isn't ready is found out by what it answers: a 503 takes it out of rotation for 5s. That costs
        # one request per replica per window; a replica that is down is retried elsewhere.
        fail_duration 5s
        max_fails 1
        unhealthy_status 503
        lb_try_duration 2s
    }
}
